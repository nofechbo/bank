PORT=3030
#list of whitelisted urls that can access BE:
WHITE_LIST_URLS=
#URL of FE server, where verification email will lead
FRONTEND_BASE_URL=


JWT_SECRET=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD= 

# Server-only OpenAI key. Never expose this value through VITE_ variables or the frontend.
OPENAI_API_KEY=
# Keep a low-cost model and hard application-side limits. Set a project budget/alert in OpenAI too.
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Emits safe OpenAI SDK request summaries; never use `debug` with sensitive traffic.
OPENAI_LOG=info
# Preferred for this learning project: create a free key at openrouter.ai.
# When set, OpenRouter is used instead of OpenAI and routes requests to a free model.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:5173
CHAT_REQUESTS_PER_MINUTE=10
# Set when deployed behind a trusted reverse proxy (e.g. 1) so req.ip is client IP.
TRUST_PROXY=

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=          
DB_NAME=

# This was inserted by `prisma init`:
# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Replace USER, PASSWORD, HOST, PORT, and DBNAME with your own values
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME"
