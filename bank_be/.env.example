PORT=3030
#list of whitelisted urls that can access BE:
WHITE_LIST_URLS=
#URL of FE server, where verification email will lead
FRONTEND_BASE_URL=


JWT_SECRET=
# Brevo sends through HTTPS, which works on Render's Free service.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=tunabankltd@gmail.com
BREVO_SENDER_NAME="Tuna Bank LTD"

# Server-only OpenAI key. Never expose through frontend variables.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
# OpenRouter is preferred when configured; otherwise use OpenAI.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:5173
# Set when deployed behind a trusted reverse proxy (e.g. 1) so req.ip is client IP.
TRUST_PROXY=

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME"
